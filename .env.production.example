# WolftekGuard en producción (VPS con nginx + PHP-FPM + MySQL).
# Copia este archivo a .env en el servidor, llena los valores marcados con <...> y corre:
#   php artisan key:generate
# Nunca subas el .env real a Git.

APP_NAME=WolftekGuard
APP_ENV=production
APP_KEY=
# Apagado: los errores muestran la página "Algo salió mal" en vez de código y rutas del servidor.
APP_DEBUG=false
APP_TIMEZONE=America/Mexico_City
APP_URL=https://<tu-dominio>

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

WOLFTEK_REGISTRO_ABIERTO=false
WOLFTEK_LIMITE_POR_MINUTO=240
# Respaldo diario a esta hora; se conservan estos días. Copia storage/app/respaldos fuera del servidor.
WOLFTEK_RESPALDOS_HORA=02:30
WOLFTEK_RESPALDOS_DIAS=14

# Un archivo de log por día, se borran los de más de 14 días; solo avisos y errores.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wolftekguard
# Un usuario solo para la app, con permisos únicamente sobre su base (no uses root).
DB_USERNAME=wolftek
DB_PASSWORD=<contraseña-larga-aleatoria>

SESSION_DRIVER=database
# 8 horas sin actividad (una jornada); con "Mantener sesión iniciada" dura más.
SESSION_LIFETIME=480
# Cifrada: las sesiones viven en la base y también salen en los respaldos.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# La cookie de sesión solo viaja por https.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Hoy nada se manda a la cola: todo se procesa al momento. Cuando haya trabajos en cola,
# cambia a "database" y corre un worker con supervisor (php artisan queue:work).
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

# Correo (recuperar contraseña). Con Gmail/Workspace usa una "contraseña de aplicación".
MAIL_MAILER=smtp
MAIL_HOST=<smtp.gmail.com>
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=<correo@tu-dominio>
MAIL_PASSWORD=<contraseña-de-aplicación>
MAIL_FROM_ADDRESS="<correo@tu-dominio>"
MAIL_FROM_NAME="${APP_NAME}"

# Inicio de sesión con redes sociales: deja vacío el proveedor que no uses.
# URL de retorno a registrar en cada consola: APP_URL/auth/{google|microsoft|facebook}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# ID del tenant de tu organización (o "consumers" para cuentas personales de Outlook). Nunca "common".
MICROSOFT_TENANT_ID=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

VITE_APP_NAME="${APP_NAME}"
