# Shared hosting (Hostinger) deploys the whole project into public_html.
# Only the public/ folder may be reachable from the web: every request is sent
# there, so .env, storage, vendor and the source code can never be downloaded.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve dotfiles (.env, .git...) from the project root.
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
